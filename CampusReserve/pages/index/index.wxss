/* ---------- 顶部区域 ---------- */

.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0 40rpx;
}

.hero__main {
  flex: 1;
  min-width: 0;
}

.hero__title {
  font-size: var(--cr-font-xxl);
  font-weight: 600;
  color: var(--cr-color-text);
}

.hero__desc {
  margin-top: 12rpx;
  font-size: var(--cr-font-md);
  color: var(--cr-color-text-secondary);
}

.hero__action {
  display: flex;
  align-items: center;
  flex: none;
  height: 64rpx;
  padding: 0 var(--cr-space-md);
  background-color: var(--cr-color-surface);
  border-radius: 999rpx;
}

.hero__action--hover {
  background-color: var(--cr-color-hover);
}

.hero__action-text {
  font-size: var(--cr-font-sm);
  color: var(--cr-color-text-secondary);
}

.hero__action-arrow {
  margin-left: 4rpx;
  font-size: var(--cr-font-sm);
  color: var(--cr-color-text-muted);
}

/* ---------- 分类入口 ---------- */

.category-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.category-item {
  box-sizing: border-box;
  width: 49%;
  padding: var(--cr-space-md);
  margin-bottom: var(--cr-space-sm);
  background-color: var(--cr-color-surface);
  border-radius: var(--cr-radius-md);
}

.category-item--hover {
  background-color: var(--cr-color-hover);
}

.category-item__label {
  display: block;
  font-size: var(--cr-font-md);
  font-weight: 600;
  color: var(--cr-color-text);
}

.category-item__desc {
  display: block;
  margin-top: 8rpx;
  font-size: var(--cr-font-sm);
  color: var(--cr-color-text-muted);
}

/* ---------- 区块标题行 ---------- */

.cr-section__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--cr-space-sm);
}

/* 覆盖 app.wxss 中 .cr-section__title 的单独下边距，避免与标题行重复留白 */
.cr-section__head .cr-section__title {
  margin-bottom: 0;
}

.cr-section__more {
  font-size: var(--cr-font-sm);
  color: var(--cr-color-text-muted);
}

/* ---------- 用户区（Phase 5） ---------- */

.user-bar {
  display: flex;
  align-items: center;
  margin-bottom: var(--cr-space-lg);
  padding: var(--cr-space-md);
  background-color: var(--cr-color-surface);
  border-radius: var(--cr-radius-md);
}

.user-bar--hover {
  background-color: var(--cr-color-hover);
}

.user-bar__avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 80rpx;
  height: 80rpx;
  margin-right: var(--cr-space-md);
  font-size: var(--cr-font-lg);
  font-weight: 600;
  color: #ffffff;
  background-color: var(--cr-color-primary);
  border-radius: 50%;
}

.user-bar__meta {
  flex: 1;
  min-width: 0;
}

.user-bar__name {
  font-size: var(--cr-font-md);
  font-weight: 600;
  color: var(--cr-color-text);
}

.user-bar__hint {
  margin-top: 4rpx;
  font-size: var(--cr-font-sm);
  color: var(--cr-color-text-muted);
}

.user-bar__arrow {
  flex: none;
  margin-left: var(--cr-space-sm);
  font-size: var(--cr-font-lg);
  color: var(--cr-color-text-muted);
}
