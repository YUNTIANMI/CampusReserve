.page {
  padding: 48rpx 32rpx;
}

.hero {
  display: flex;
  flex-direction: column;
  padding: 40rpx 0 48rpx;
}

.hero__title {
  font-size: 48rpx;
  font-weight: 600;
  color: #1f2329;
}

.hero__desc {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #646a73;
}

.card {
  padding: 8rpx 28rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
}

.card__row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #eef0f3;
}

.card__row:last-child {
  border-bottom: none;
}

.card__label {
  font-size: 26rpx;
  color: #8f959e;
}

.card__value {
  font-size: 28rpx;
  color: #1f2329;
}

.hint {
  margin-top: 32rpx;
  font-size: 24rpx;
  color: #8f959e;
  line-height: 1.6;
}
