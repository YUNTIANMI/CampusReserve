.hero {
  display: flex;
  flex-direction: column;
  padding: 24rpx 0 48rpx;
}

.hero__title {
  font-size: var(--cr-font-xxl);
  font-weight: 600;
  color: var(--cr-color-text);
}

.hero__desc {
  margin-top: 12rpx;
  font-size: var(--cr-font-md);
  color: var(--cr-color-text-secondary);
}

.entry {
  display: flex;
  flex-direction: column;
  flex: 1;
  padding-right: 16rpx;
}

.entry__title {
  font-size: var(--cr-font-md);
  color: var(--cr-color-text);
}

.entry__desc {
  margin-top: 8rpx;
  font-size: var(--cr-font-sm);
  color: var(--cr-color-text-muted);
}

.entry__arrow {
  font-size: 36rpx;
  color: var(--cr-color-text-muted);
}
