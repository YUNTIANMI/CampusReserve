<view class="cr-page">
  <!-- 参数缺失或非法：不渲染空白页，给出明确提示 -->
  <error-state
    wx:if="{{!hasValidId}}"
    message="缺少或非法的资源 ID 参数"
    button-text="返回上一页"
    bind:retry="onBack"
  />

  <block wx:else>
    <!-- 资源信息区：四态互斥，任何时刻只渲染其一 -->
    <loading-state wx:if="{{pageState === 'loading'}}" text="正在加载资源详情" />

    <error-state
      wx:elif="{{pageState === 'error'}}"
      message="{{errorMessage}}"
      bind:retry="onRetryDetail"
    />

    <!-- 资源不存在：重试无意义，只给「返回上一页」 -->
    <empty-state
      wx:elif="{{pageState === 'empty'}}"
      text="资源不存在"
      description="该资源可能已下架，请返回列表重新选择"
      action-text="返回上一页"
      bind:action="onBack"
    />

    <block wx:else>
      <!-- 图片展示；无图时用类型名占位，避免出现空白块 -->
      <view class="detail-hero">
        <image
          class="detail-hero__image"
          wx:if="{{resource.imageUrl}}"
          src="{{resource.imageUrl}}"
          mode="aspectFill"
        />
        <view class="detail-hero__placeholder" wx:else>{{typeLabel}}</view>
      </view>

      <!-- 资源信息 -->
      <view class="cr-section info">
        <view class="info__name">{{resource.name}}</view>
        <view class="info__meta">
          <text class="info__tag">{{typeLabel}}</text>
          <text class="info__capacity">可容纳 {{resource.capacity}} 人</text>
        </view>
        <view class="info__location">{{resource.location}}</view>
        <view class="info__desc">{{resource.description}}</view>
      </view>

      <!--
        日期选择：静态内容，不随资源信息区与时间段区的四态变化。
        某个日期取不到时段时，用户仍应能切换到其他日期。
      -->
      <view class="cr-section">
        <view class="cr-section__title">选择日期</view>
        <scroll-view class="date-bar" scroll-x enable-flex scroll-with-animation>
          <view
            class="date-bar__item {{item.value === selectedDate ? 'date-bar__item--active' : ''}}"
            wx:for="{{dateOptions}}"
            wx:key="value"
            data-value="{{item.value}}"
            hover-class="date-bar__item--hover"
            hover-stay-time="80"
            bindtap="onTapDate"
          >
            <text class="date-bar__weekday">{{item.isToday ? '今天' : item.weekday}}</text>
            <text class="date-bar__date">{{item.shortLabel}}</text>
          </view>
        </scroll-view>
      </view>

      <!-- 可用时间段：状态独立于资源信息区 -->
      <view class="cr-section">
        <view class="cr-section__title">选择时间段</view>

        <loading-state wx:if="{{slotState === 'loading'}}" text="正在加载时间段" />

        <error-state
          wx:elif="{{slotState === 'error'}}"
          message="{{slotError}}"
          bind:retry="onRetrySlots"
        />

        <empty-state
          wx:elif="{{slotState === 'empty'}}"
          text="该日期暂无开放时段"
          description="请选择其他日期查看"
        />

        <block wx:else>
          <view class="slots">
            <view class="slots__item" wx:for="{{slots}}" wx:key="startTime">
              <time-slot
                slot-data="{{item}}"
                selected="{{selectedSlot && selectedSlot.startTime === item.startTime}}"
                bind:slottap="onTapSlot"
              />
            </view>
          </view>
          <view class="slots__hint" wx:if="{{slotHint}}">{{slotHint}}</view>
        </block>
      </view>

      <!-- 预约入口 -->
      <view class="submit">
        <view class="submit__summary" wx:if="{{selectedSlot}}">
          已选时段 {{selectedSlot.startTime}}-{{selectedSlot.endTime}}（{{selectedDate}} {{selectedWeekday}}）
        </view>
        <view class="submit__summary submit__summary--muted" wx:else>
          请选择上方任一时间段后再提交
        </view>
        <!--
          提交失败的原因留在页面上而不只弹 toast：toast 会消失，
          而「该时段已被预约」是需要用户据此改变行为的提示，必须能反复看到。
        -->
        <view class="submit__error" wx:if="{{submitError}}">{{submitError}}</view>
        <!--
          按钮配色分两段：底色看「有没有选中时段」（提交中依然是主色，表示这是一次进行中的提交），
          是否变淡看 canSubmit（提交中会变淡并停止响应点击，避免重复预约）。
        -->
        <view
          class="submit__button cr-btn cr-btn--block {{selectedSlot ? 'cr-btn--primary' : 'cr-btn--disabled'}} {{canSubmit ? '' : 'cr-btn--disabled'}}"
          hover-class="{{canSubmit ? 'cr-hover' : 'none'}}"
          hover-stay-time="80"
          bindtap="onSubmit"
        >{{submitText}}</view>
      </view>
    </block>
  </block>
</view>
