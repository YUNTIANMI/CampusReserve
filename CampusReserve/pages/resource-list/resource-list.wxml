<view class="cr-page">
  <!--
    分类筛选栏：静态内容，不随列表四态变化。
    接口失败或结果为空时用户仍能切换分类，避免「一次请求失败就整页不可用」。
  -->
  <scroll-view class="filter" scroll-x enable-flex scroll-with-animation>
    <view
      class="filter__item {{item.value === category ? 'filter__item--active' : ''}}"
      wx:for="{{filterOptions}}"
      wx:key="label"
      data-value="{{item.value}}"
      hover-class="filter__item--hover"
      hover-stay-time="80"
      bindtap="onTapFilter"
    >
      <text class="filter__item-text">{{item.label}}</text>
    </view>
  </scroll-view>

  <!-- 列表区：四态互斥，任何时刻只渲染其一 -->
  <loading-state wx:if="{{pageState === 'loading'}}" text="正在加载资源" />

  <error-state
    wx:elif="{{pageState === 'error'}}"
    message="{{errorMessage}}"
    bind:retry="onRetry"
  />

  <empty-state
    wx:elif="{{pageState === 'empty'}}"
    text="{{emptyText}}"
    description="{{emptyDescription}}"
    action-text="{{emptyActionText}}"
    bind:action="onRetry"
  />

  <block wx:else>
    <resource-card
      wx:for="{{resources}}"
      wx:key="id"
      resource="{{item}}"
      bind:cardtap="onTapResource"
    />
  </block>
</view>
