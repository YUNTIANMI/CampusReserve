<view class="cr-page">
  <!-- 参数缺失：不渲染空白页，给出明确提示 -->
  <error-state
    wx:if="{{!hasValidId}}"
    message="缺少或非法的预约 ID 参数"
    button-text="返回上一页"
    bind:retry="onBack"
  />

  <block wx:else>
    <view class="cr-section">
      <view class="cr-section__title">预约详情</view>
      <view class="cr-section__desc">预约成功后可在这里查看场地、时间与状态。</view>
    </view>

    <loading-state wx:if="{{pageState === 'loading'}}" />

    <error-state
      wx:elif="{{pageState === 'error'}}"
      message="{{errorMessage}}"
      button-text="重新加载"
      bind:retry="onRetry"
    />

    <!-- 查不到时不给重试：请求本身是成功的，重试也一样没有 -->
    <empty-state
      wx:elif="{{pageState === 'empty'}}"
      text="未找到该预约"
      description="该预约不存在，或不属于当前账号。"
      action-text="返回上一页"
      bind:action="onBack"
    />

    <block wx:else>
      <view class="cr-card">
        <view class="cr-list__item">
          <text class="cr-text-secondary cr-text-sm">预约编号</text>
          <text class="cr-text-strong">#{{bookingId}}</text>
        </view>
        <view class="cr-list__item">
          <text class="cr-text-secondary cr-text-sm">场地</text>
          <text class="cr-text-strong">{{resourceName}}</text>
        </view>
        <view class="cr-list__item">
          <text class="cr-text-secondary cr-text-sm">地点</text>
          <text class="cr-text-secondary">{{location}}</text>
        </view>
        <view class="cr-list__item">
          <text class="cr-text-secondary cr-text-sm">日期</text>
          <text class="cr-text-secondary">{{dateLabel}}</text>
        </view>
        <view class="cr-list__item">
          <text class="cr-text-secondary cr-text-sm">时间段</text>
          <text class="cr-text-strong">{{timeLabel}}</text>
        </view>
        <view class="cr-list__item">
          <text class="cr-text-secondary cr-text-sm">预约状态</text>
          <view class="badge badge--{{statusModifier}}">{{statusLabel}}</view>
        </view>
        <view class="cr-list__item">
          <text class="cr-text-secondary cr-text-sm">下单时间</text>
          <text class="cr-text-secondary">{{createdAt}}</text>
        </view>
      </view>

      <view class="nav">
        <view class="cr-btn cr-btn--ghost cr-btn--block" hover-class="cr-hover" bindtap="onOpenBookings">
          返回我的预约
        </view>
      </view>
    </block>
  </block>
</view>
