<view class="cr-page">
  <view class="cr-section">
    <view class="cr-section__title">我的预约</view>
    <view class="cr-section__desc">登录后可查看与管理自己的预约。</view>
  </view>

  <!-- 页签在未登录时也保持渲染：让用户看到这个页面能做什么，而不是只剩一个按钮 -->
  <view class="tabs">
    <view
      class="tabs__item {{activeStatus === item.status ? 'tabs__item--active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="status"
      data-status="{{item.status}}"
      hover-class="cr-hover"
      hover-stay-time="80"
      bindtap="onTabChange"
    >{{item.label}}</view>
  </view>

  <!-- 未登录：引导登录，不展示预约内容 -->
  <empty-state
    wx:if="{{loginState === 'LOGGED_OUT'}}"
    text="登录后查看我的预约"
    description="我的预约属于个人数据，登录后即可查看待使用、已完成与已取消的预约。"
    action-text="去登录"
    bind:action="onGoLogin"
  />

  <block wx:else>
    <loading-state wx:if="{{pageState === 'loading'}}" />

    <error-state
      wx:elif="{{pageState === 'error'}}"
      message="{{errorMessage}}"
      button-text="重新加载"
      bind:retry="onRetry"
    />

    <empty-state
      wx:elif="{{pageState === 'empty'}}"
      text="{{emptyText}}"
      description="{{emptyDescription}}"
    />

    <view class="list" wx:else>
      <booking-card
        wx:for="{{list}}"
        wx:key="id"
        booking="{{item}}"
        bind:cardtap="onOpenBooking"
      />
    </view>
  </block>
</view>
