/* 自定义组件默认样式隔离，仅 CSS 自定义属性可从 page 继承，故此处全部带 var 回退值。 */
.time-slot {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  padding: var(--cr-space-md, 24rpx) var(--cr-space-xs, 8rpx);
  background-color: var(--cr-color-surface, #ffffff);
  border: 1rpx solid var(--cr-color-border-strong, #dcdfe5);
  border-radius: var(--cr-radius-md, 16rpx);
}

/* hover 写在 selected 之前：两者同为单类选择器，后写的 selected 才能覆盖 hover 背景 */
.time-slot--hover {
  background-color: var(--cr-color-hover, #f2f3f5);
}

.time-slot--selected {
  background-color: var(--cr-color-primary, #2f6bff);
  border-color: var(--cr-color-primary, #2f6bff);
}

.time-slot--disabled {
  background-color: var(--cr-color-bg, #f5f6f8);
  border-color: var(--cr-color-border, #eef0f3);
}

.time-slot__label {
  font-size: var(--cr-font-md, 28rpx);
  color: var(--cr-color-text, #1f2329);
}

.time-slot__status {
  margin-top: 6rpx;
  font-size: var(--cr-font-xs, 22rpx);
  color: var(--cr-color-text-muted, #8f959e);
}

.time-slot--selected .time-slot__label,
.time-slot--selected .time-slot__status {
  color: #ffffff;
}

.time-slot--disabled .time-slot__label {
  color: var(--cr-color-text-muted, #8f959e);
}
