<view class="empty-state">
  <view class="empty-state__icon">
    <view class="empty-state__icon-line"></view>
  </view>
  <text class="empty-state__text">{{text}}</text>
  <text class="empty-state__desc" wx:if="{{description}}">{{description}}</text>
  <view
    class="empty-state__action"
    wx:if="{{actionText}}"
    hover-class="empty-state__action--hover"
    hover-stay-time="80"
    bindtap="handleAction"
  >{{actionText}}</view>
</view>
