/* 自定义组件默认样式隔离，不继承 app.wxss 的类名；仅 CSS 自定义属性可继承。 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 96rpx 32rpx;
}

.loading-state__spinner {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid var(--cr-color-border, #eef0f3);
  border-top-color: var(--cr-color-primary, #2f6bff);
  border-radius: 50%;
  animation: loading-state-spin 0.8s linear infinite;
}

.loading-state__text {
  margin-top: 24rpx;
  font-size: var(--cr-font-sm, 26rpx);
  color: var(--cr-color-text-muted, #8f959e);
}

@keyframes loading-state-spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}
