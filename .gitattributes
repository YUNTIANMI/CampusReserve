# 统一换行符，避免 Windows / macOS / Linux 协作产生无意义的整文件 diff
* text=auto eol=lf

# Windows 批处理必须使用 CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Maven Wrapper 脚本
mvnw text eol=lf
mvnw.cmd text eol=crlf

# 二进制文件不做换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.woff binary
*.woff2 binary
